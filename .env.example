# =============================================================================
# Git Aura Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL database connection string
# Format: postgresql://username:password@host:port/database
# neon db database 
DATABASE_URL="postgresql://username:password@localhost:5432/gitaura"
NEXT_PUBLIC_GITHUB_TOKEN
NEXT_PUBLIC_IMGBB_API_KEY
NEXT_PUBLIC_BASE_URL
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY
GITHUB_TOKEN
CLERK_WEBHOOK_SECRET
ADMIN_EMAILS
ADMIN_GITHUB_USERNAMES
CRON_SECRET
OPEN_AI_API_KEY
# Admin panel (git-aura-admin) server-to-server secret, sent as the x-admin-secret header.
# Must match ADMIN_API_SECRET in the admin app. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_SECRET=replace-with-a-long-random-string
